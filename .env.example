# Trans-Atlas Services backend (server/) — copy to .env if/when you wire up
# a real env-loading step. Right now server/config.js reads process.env
# directly with safe defaults, so none of these are required to run locally.

# Port the internal API listens on. Optional — defaults to 8787.
PORT=8787

# Shown in the User-Agent header sent to every external source, and in
# SOURCES.md-style docs, so a source operator can identify/contact us
# instead of just seeing an anonymous scraper. Optional.
SERVICE_CONTACT_URL=https://github.com/dymytriipryl/trans-atlas

# --- Not used yet (Phase 1 only implements Open-Meteo, which needs no key) ---
# Required once the Copernicus Marine connector (Phase 2, sea weather) is added:
# CMEMS_USERNAME=
# CMEMS_PASSWORD=
