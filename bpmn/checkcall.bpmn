<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_checkcall" targetNamespace="http://logistics/checkcall">
  <bpmn:process id="proc_checkcall" name="Автоматизований check-call" isExecutable="false">
    <bpmn:laneSet id="laneset_1">
      <bpmn:lane id="lane_sys" name="Оркестратор трекінгу (система)">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fresh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_geo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_geo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dlv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ai" name="AI check-call агент">
        <bpmn:flowNodeRef>t_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_parse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_exc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_resp</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_disp" name="Диспетчер (людина)">
        <bpmn:flowNodeRef>sp_exc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>be_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end_x</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Вантаж призначено перевізнику">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t_plan" name="Активувати план трекінгу: геозони, вікна, частота">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e_timer" name="Інтервал моніторингу">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_e_timer"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_pos" name="Отримати позицію: ELD / GPS / застосунок водія">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_fresh" name="Дані актуальні?">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_dev" name="Відхилення від плану?">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_upd" name="Оновити статус у TMS і сповістити клієнта">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:task>
    <bpmn:startEvent id="e_geo" name="Геозона: прибуття або виїзд">
      <bpmn:outgoing>flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="md_e_geo"/>
    </bpmn:startEvent>
    <bpmn:task id="t_geo" name="Авто check-in / check-out, timestamp, сповіщення">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_dlv" name="Це доставка?">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pod" name="Зібрати POD, статус «Delivered»">
      <bpmn:incoming>flow_25</bpmn:incoming>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_end_ok" name="Доставку підтверджено">
      <bpmn:incoming>flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_call" name="AI телефонує водієві та записує статус">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_ans" name="Водій відповів?">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_parse" name="Розпізнати відповідь, записати локацію та ETA">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_exc" name="Виявлено виняток?">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_sms" name="Надіслати SMS та email із запитом статусу">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e_wait" name="Очікування 15 хв">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_e_wait"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_resp" name="Отримано відповідь?">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_exc" name="Обробка винятку">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
      <bpmn:startEvent id="s_start" name="Виняток зареєстровано">
        <bpmn:outgoing>flow_27</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="s_class" name="Класифікувати виняток за типом, джерелом і впливом на SLA">
        <bpmn:incoming>flow_27</bpmn:incoming>
        <bpmn:outgoing>flow_28</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="s_gw" name="Тип винятку?">
        <bpmn:incoming>flow_28</bpmn:incoming>
        <bpmn:outgoing>flow_29</bpmn:outgoing>
        <bpmn:outgoing>flow_32</bpmn:outgoing>
        <bpmn:outgoing>flow_35</bpmn:outgoing>
        <bpmn:outgoing>flow_38</bpmn:outgoing>
        <bpmn:outgoing>flow_41</bpmn:outgoing>
        <bpmn:outgoing>flow_44</bpmn:outgoing>
        <bpmn:outgoing>flow_47</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="a1" name="Перепризначити appointment зі складом або отримувачем">
        <bpmn:incoming>flow_29</bpmn:incoming>
        <bpmn:outgoing>flow_31</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="a2" name="Оновити вікно доставки та ETA у TMS">
        <bpmn:incoming>flow_31</bpmn:incoming>
        <bpmn:outgoing>flow_30</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="b1" name="Дзвінок перевізнику для відновлення зв&#x27;язку">
        <bpmn:incoming>flow_32</bpmn:incoming>
        <bpmn:outgoing>flow_34</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="b2" name="Пошук заміни або процедура lost load">
        <bpmn:incoming>flow_34</bpmn:incoming>
        <bpmn:outgoing>flow_33</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="c1" name="Залучити roadside assistance, оцінити стан вантажу">
        <bpmn:incoming>flow_35</bpmn:incoming>
        <bpmn:outgoing>flow_37</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="c2" name="Організувати recovery truck і перевантаження">
        <bpmn:incoming>flow_37</bpmn:incoming>
        <bpmn:outgoing>flow_36</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="d1" name="Перерахувати ETA з урахуванням HOS і трафіку">
        <bpmn:incoming>flow_38</bpmn:incoming>
        <bpmn:outgoing>flow_40</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="d2" name="Проактивно повідомити клієнта про затримку">
        <bpmn:incoming>flow_40</bpmn:incoming>
        <bpmn:outgoing>flow_39</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="e1" name="Запустити таймери detention і простою">
        <bpmn:incoming>flow_41</bpmn:incoming>
        <bpmn:outgoing>flow_43</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="e2" name="Погодити accessorial charge із клієнтом">
        <bpmn:incoming>flow_43</bpmn:incoming>
        <bpmn:outgoing>flow_42</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="f1" name="Запросити фото BOL, POD і опис розбіжності">
        <bpmn:incoming>flow_44</bpmn:incoming>
        <bpmn:outgoing>flow_46</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="f2" name="Відкрити OS&amp;D claim, повідомити страховика">
        <bpmn:incoming>flow_46</bpmn:incoming>
        <bpmn:outgoing>flow_45</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="g1" name="Заблокувати вантаж, вимагати ліцензію та страховку">
        <bpmn:incoming>flow_47</bpmn:incoming>
        <bpmn:outgoing>flow_49</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="g2" name="Перевірити ознаки double-brokering у профілі">
        <bpmn:incoming>flow_49</bpmn:incoming>
        <bpmn:outgoing>flow_48</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="s_merge" name="">
        <bpmn:incoming>flow_30</bpmn:incoming>
        <bpmn:incoming>flow_33</bpmn:incoming>
        <bpmn:incoming>flow_36</bpmn:incoming>
        <bpmn:incoming>flow_39</bpmn:incoming>
        <bpmn:incoming>flow_42</bpmn:incoming>
        <bpmn:incoming>flow_45</bpmn:incoming>
        <bpmn:incoming>flow_48</bpmn:incoming>
        <bpmn:outgoing>flow_50</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="s_log" name="Задокументувати причину, тег винятку й рішення в TMS">
        <bpmn:incoming>flow_50</bpmn:incoming>
        <bpmn:outgoing>flow_51</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="s_sla" name="Ризик SLA?">
        <bpmn:incoming>flow_51</bpmn:incoming>
        <bpmn:outgoing>flow_52</bpmn:outgoing>
        <bpmn:outgoing>flow_54</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="s_comp" name="Узгодити компенсацію та новий SLA із клієнтом">
        <bpmn:incoming>flow_52</bpmn:incoming>
        <bpmn:outgoing>flow_53</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="s_merge2" name="">
        <bpmn:incoming>flow_53</bpmn:incoming>
        <bpmn:incoming>flow_54</bpmn:incoming>
        <bpmn:outgoing>flow_55</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="s_cont" name="Рейс можна продовжити?">
        <bpmn:incoming>flow_55</bpmn:incoming>
        <bpmn:outgoing>flow_56</bpmn:outgoing>
        <bpmn:outgoing>flow_57</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="s_end_ok" name="Виняток закрито, моніторинг триває">
        <bpmn:incoming>flow_56</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="s_end_err" name="Рейс неможливо продовжити">
        <bpmn:incoming>flow_57</bpmn:incoming>
        <bpmn:errorEventDefinition id="ed_s_end_err"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_27" sourceRef="s_start" targetRef="s_class"/>
      <bpmn:sequenceFlow id="flow_28" sourceRef="s_class" targetRef="s_gw"/>
      <bpmn:sequenceFlow id="flow_29" name="Пропущене вікно pickup або delivery" sourceRef="s_gw" targetRef="a1"/>
      <bpmn:sequenceFlow id="flow_30" sourceRef="a2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_31" sourceRef="a1" targetRef="a2"/>
      <bpmn:sequenceFlow id="flow_32" name="Втрата трекінгу, водій недоступний" sourceRef="s_gw" targetRef="b1"/>
      <bpmn:sequenceFlow id="flow_33" sourceRef="b2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_34" sourceRef="b1" targetRef="b2"/>
      <bpmn:sequenceFlow id="flow_35" name="Поломка, ДТП, потреба в recovery" sourceRef="s_gw" targetRef="c1"/>
      <bpmn:sequenceFlow id="flow_36" sourceRef="c2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_37" sourceRef="c1" targetRef="c2"/>
      <bpmn:sequenceFlow id="flow_38" name="Затримка в дорозі: HOS, трафік, погода" sourceRef="s_gw" targetRef="d1"/>
      <bpmn:sequenceFlow id="flow_39" sourceRef="d2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_40" sourceRef="d1" targetRef="d2"/>
      <bpmn:sequenceFlow id="flow_41" name="Detention, простій, lumper" sourceRef="s_gw" targetRef="e1"/>
      <bpmn:sequenceFlow id="flow_42" sourceRef="e2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_43" sourceRef="e1" targetRef="e2"/>
      <bpmn:sequenceFlow id="flow_44" name="Розбіжність документів, OS&amp;D" sourceRef="s_gw" targetRef="f1"/>
      <bpmn:sequenceFlow id="flow_45" sourceRef="f2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_46" sourceRef="f1" targetRef="f2"/>
      <bpmn:sequenceFlow id="flow_47" name="Комплаєнс перевізника" sourceRef="s_gw" targetRef="g1"/>
      <bpmn:sequenceFlow id="flow_48" sourceRef="g2" targetRef="s_merge"/>
      <bpmn:sequenceFlow id="flow_49" sourceRef="g1" targetRef="g2"/>
      <bpmn:sequenceFlow id="flow_50" sourceRef="s_merge" targetRef="s_log"/>
      <bpmn:sequenceFlow id="flow_51" sourceRef="s_log" targetRef="s_sla"/>
      <bpmn:sequenceFlow id="flow_52" name="так" sourceRef="s_sla" targetRef="s_comp"/>
      <bpmn:sequenceFlow id="flow_53" sourceRef="s_comp" targetRef="s_merge2"/>
      <bpmn:sequenceFlow id="flow_54" name="ні" sourceRef="s_sla" targetRef="s_merge2"/>
      <bpmn:sequenceFlow id="flow_55" sourceRef="s_merge2" targetRef="s_cont"/>
      <bpmn:sequenceFlow id="flow_56" name="так" sourceRef="s_cont" targetRef="s_end_ok"/>
      <bpmn:sequenceFlow id="flow_57" name="ні" sourceRef="s_cont" targetRef="s_end_err"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="be_timer" name="Не вирішено за 60 хв" attachedToRef="sp_exc" cancelActivity="false">
      <bpmn:outgoing>flow_19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="td_be_timer"/>
    </bpmn:boundaryEvent>
    <bpmn:task id="t_lead" name="Ескалація керівнику зміни">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_lead" name="Керівника зміни підключено">
      <bpmn:incoming>flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="be_err" name="Рейс неможливо продовжити" attachedToRef="sp_exc">
      <bpmn:outgoing>flow_21</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed_be_err"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="e_end_x" name="Рейс закрито з винятком">
      <bpmn:incoming>flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="e_start" targetRef="t_plan"/>
    <bpmn:sequenceFlow id="flow_2" sourceRef="t_plan" targetRef="e_timer"/>
    <bpmn:sequenceFlow id="flow_3" sourceRef="e_timer" targetRef="t_pos"/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="t_pos" targetRef="g_fresh"/>
    <bpmn:sequenceFlow id="flow_5" name="так" sourceRef="g_fresh" targetRef="g_dev"/>
    <bpmn:sequenceFlow id="flow_6" name="ні — у графіку" sourceRef="g_dev" targetRef="t_upd"/>
    <bpmn:sequenceFlow id="flow_7" name="ні — тиша &gt; 30 хв" sourceRef="g_fresh" targetRef="t_call"/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="t_call" targetRef="g_ans"/>
    <bpmn:sequenceFlow id="flow_9" name="так" sourceRef="g_ans" targetRef="t_parse"/>
    <bpmn:sequenceFlow id="flow_10" sourceRef="t_parse" targetRef="g_exc"/>
    <bpmn:sequenceFlow id="flow_11" name="ні" sourceRef="g_exc" targetRef="t_upd"/>
    <bpmn:sequenceFlow id="flow_12" name="ні" sourceRef="g_ans" targetRef="t_sms"/>
    <bpmn:sequenceFlow id="flow_13" sourceRef="t_sms" targetRef="e_wait"/>
    <bpmn:sequenceFlow id="flow_14" sourceRef="e_wait" targetRef="g_resp"/>
    <bpmn:sequenceFlow id="flow_15" name="так" sourceRef="g_resp" targetRef="t_parse"/>
    <bpmn:sequenceFlow id="flow_16" name="так — виняток" sourceRef="g_exc" targetRef="sp_exc"/>
    <bpmn:sequenceFlow id="flow_17" name="ні — 2 спроби" sourceRef="g_resp" targetRef="sp_exc"/>
    <bpmn:sequenceFlow id="flow_18" name="виняток вирішено — повернення в моніторинг" sourceRef="sp_exc" targetRef="e_timer"/>
    <bpmn:sequenceFlow id="flow_19" sourceRef="be_timer" targetRef="t_lead"/>
    <bpmn:sequenceFlow id="flow_20" sourceRef="t_lead" targetRef="e_lead"/>
    <bpmn:sequenceFlow id="flow_21" sourceRef="be_err" targetRef="e_end_x"/>
    <bpmn:sequenceFlow id="flow_22" sourceRef="e_geo" targetRef="t_geo"/>
    <bpmn:sequenceFlow id="flow_23" sourceRef="t_geo" targetRef="g_dlv"/>
    <bpmn:sequenceFlow id="flow_24" name="ні" sourceRef="g_dlv" targetRef="e_timer"/>
    <bpmn:sequenceFlow id="flow_25" name="так" sourceRef="g_dlv" targetRef="t_pod"/>
    <bpmn:sequenceFlow id="flow_26" sourceRef="t_pod" targetRef="e_end_ok"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag_1">
    <bpmndi:BPMNPlane id="plane_main" bpmnElement="proc_checkcall">
