{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trans-atlas.net/schemas/verification.schema.json",
  "title": "Верифікація контрагента",
  "description": "Канонічні форми модуля верифікації: результат окремої перевірки, справа, досьє компанії та подія зміни реквізитів. Один опис для API, БД і коннекторів.",
  "type": "object",
  "$defs": {
    "checkStatus": {
      "enum": ["pass", "attention", "fail", "unavailable", "not_applicable", "pending"],
      "description": "unavailable означає, що джерело не відповіло або не покриває суб'єкта. Воно ніколи не еквівалентне pass."
    },
    "level": {"enum": ["L0", "L1", "L2"]},
    "caseStatus": {
      "enum": ["draft", "awaiting_input", "running", "manual_review",
               "approved", "rejected", "expired", "revoked"]
    },
    "severity": {"enum": ["info", "attention", "critical"]},
    "requisiteKind": {
      "enum": ["legal_name", "legal_address", "status", "director", "beneficiary",
               "kved", "bank_account", "phone", "email", "website", "capital"]
    },
    "identifierKind": {"enum": ["edrpou", "vat_eu", "nip", "regon", "krs", "lei", "other"]},
    "uuid": {"type": "string", "format": "uuid",
             "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "country": {"type": "string", "pattern": "^[A-Z]{2}$"},

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_sha256", "content_type", "fetched_at", "storage_uri"],
      "properties": {
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_size": {"type": "integer", "minimum": 0},
        "content_type": {"type": "string"},
        "storage_uri": {"type": "string"},
        "http_status": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
        "fetched_at": {"type": "string", "format": "date-time"},
        "source_as_of": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}],
                         "description": "Дата стану даних у джерелі. Саме вона визначає свіжість, а не час запиту."},
        "retention_until": {"type": "string", "format": "date"}
      }
    },

    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "source_id", "status", "subject", "requested_at"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "check_id": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "status": {"$ref": "#/$defs/checkStatus"},
        "subject": {
          "type": "object",
          "description": "Що саме звірялося",
          "properties": {
            "identifier_kind": {"$ref": "#/$defs/identifierKind"},
            "identifier_value": {"type": "string"},
            "country": {"$ref": "#/$defs/country"},
            "name": {"type": "string"}
          }
        },
        "findings": {"type": "object", "description": "Нормалізований зріз відповіді джерела"},
        "reason_code": {"anyOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,39}$"},
                                  {"type": "null"}]},
        "reason_text": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "requested_at": {"type": "string", "format": "date-time"},
        "responded_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "valid_until": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "latency_ms": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "attempt": {"type": "integer", "minimum": 1},
        "evidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "description": "Будь-який статус, крім pass і pending, зобов'язаний нести причину.",
          "if": {"properties": {"status": {"enum": ["attention", "fail", "unavailable", "not_applicable"]}},
                 "required": ["status"]},
          "then": {"required": ["reason_code"],
                   "properties": {"reason_code": {"type": "string"}}}
        },
        {
          "description": "Недоступне джерело не має права нести знахідки.",
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {"properties": {"findings": {"maxProperties": 0}}}
        },
        {
          "description": "Позитивний результат зобов'язаний мати строк дії і доказ.",
          "if": {"properties": {"status": {"enum": ["pass", "attention"]}}, "required": ["status"]},
          "then": {"required": ["valid_until", "responded_at"],
                   "properties": {"valid_until": {"type": "string"},
                                  "responded_at": {"type": "string"}}}
        },
        {
          "description": "Незавершена перевірка не має часу відповіді.",
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {"properties": {"responded_at": {"type": "null"},
                                  "evidence": {"type": "null"}}}
        }
      ]
    },

    "verificationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "target_level", "status", "created_at", "results"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "company_id": {"$ref": "#/$defs/uuid"},
        "target_level": {"enum": ["L1", "L2"]},
        "status": {"$ref": "#/$defs/caseStatus"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/checkResult"}},
        "blocking_unavailable": {
          "type": "array", "items": {"type": "string"},
          "description": "Перевірки, які не вдалося виконати і які блокують позитивне рішення. Порожній масив — обов'язкова умова схвалення."
        },
        "decided_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "decision_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "expires_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "description": "Схвалення неможливе, поки лишається невиконана блокуюча перевірка.",
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["expires_at", "decided_at", "blocking_unavailable"],
                   "properties": {"blocking_unavailable": {"maxItems": 0},
                                  "expires_at": {"type": "string"},
                                  "decided_at": {"type": "string"}}}
        },
        {
          "description": "Відмова й відкликання зобов'язані мати причину.",
          "if": {"properties": {"status": {"enum": ["rejected", "revoked"]}}, "required": ["status"]},
          "then": {"required": ["decision_reason", "decided_at"],
                   "properties": {"decision_reason": {"type": "string"}}}
        }
      ]
    },

    "requisiteChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "kind", "source_id", "severity", "detected_at",
                   "suspends_level"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "company_id": {"$ref": "#/$defs/uuid"},
        "kind": {"$ref": "#/$defs/requisiteKind"},
        "old_value": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "new_value": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "source_id": {"type": "string"},
        "severity": {"$ref": "#/$defs/severity"},
        "detected_at": {"type": "string", "format": "date-time"},
        "notified_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "suspends_level": {"type": "boolean"}
      },
      "allOf": [
        {
          "description": "Критична зміна зобов'язана призупиняти рівень, інакше severity нічого не означає.",
          "if": {"properties": {"severity": {"const": "critical"}}, "required": ["severity"]},
          "then": {"properties": {"suspends_level": {"const": true}}}
        },
        {
          "description": "Зміна банківського рахунку або керівника завжди критична: саме на цьому будується шахрайство з підміною реквізитів.",
          "if": {"properties": {"kind": {"enum": ["bank_account", "director", "beneficiary"]}},
                 "required": ["kind"]},
          "then": {"properties": {"severity": {"const": "critical"}}}
        }
      ]
    },

    "dossier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "display_name", "country", "level", "checks", "as_of"],
      "properties": {
        "company_id": {"$ref": "#/$defs/uuid"},
        "display_name": {"type": "string"},
        "country": {"$ref": "#/$defs/country"},
        "level": {"$ref": "#/$defs/level"},
        "level_expires_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "is_suspended": {"type": "boolean"},
        "suspend_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "checks": {
          "type": "array",
          "description": "Перелік перевірок із джерелом і датою. Зведеної оцінки чи зірочок немає навмисно: користувач бачить факти, а не думку майданчика.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "title", "status", "source_title", "checked_at"],
            "properties": {
              "check_id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"$ref": "#/$defs/checkStatus"},
              "source_title": {"type": "string"},
              "source_url": {"anyOf": [{"type": "string"}, {"type": "null"}]},
              "checked_at": {"type": "string", "format": "date-time"},
              "source_as_of": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}]},
              "is_stale": {"type": "boolean"},
              "reason_text": {"anyOf": [{"type": "string"}, {"type": "null"}]}
            }
          }
        },
        "material_changes": {"type": "array", "items": {"$ref": "#/$defs/requisiteChange"}},
        "as_of": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "description": "Досьє рівня вище L0 зобов'язане показувати строк дії.",
          "if": {"properties": {"level": {"enum": ["L1", "L2"]}}, "required": ["level"]},
          "then": {"required": ["level_expires_at"],
                   "properties": {"level_expires_at": {"type": "string"}}}
        },
        {
          "description": "Призупинення показується з причиною.",
          "if": {"properties": {"is_suspended": {"const": true}}, "required": ["is_suspended"]},
          "then": {"required": ["suspend_reason"],
                   "properties": {"suspend_reason": {"type": "string"}}}
        }
      ]
    }
  },

  "oneOf": [
    {"$ref": "#/$defs/checkResult"},
    {"$ref": "#/$defs/verificationCase"},
    {"$ref": "#/$defs/requisiteChange"},
    {"$ref": "#/$defs/dossier"}
  ]
}
